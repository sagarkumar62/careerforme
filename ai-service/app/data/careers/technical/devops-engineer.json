      "description": "Write automation scripts, interact with cloud SDKs (boto3), REST APIs, and CLI tooling using Python or Go.",
      "type": "core",
      "difficulty": "intermediate",
      "importance": 0.9,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "linux-shell"
      ]
    },
    {
