      "description": "Master cloud infrastructure concepts (IaaS, PaaS), EC2/Compute Engine, S3/Cloud Storage, IAM access management, and VPC networks.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 0.98,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "linux-shell",
        "networking-security"
      ]
    },
