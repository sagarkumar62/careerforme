      "nodeId": "git-github",
      "title": "Git & GitHub Version Control",
      "description": "Master Git branching strategies (GitFlow/Trunk-based), pull requests, merge conflict resolution, and GitHub collaboration.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 0.95,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": []
    },
