{
  "id": "devops-engineer",
  "careerId": "devops-engineer",
  "career_id": "devops-engineer",
  "title": "DevOps Engineer",
  "domain": "technology",
  "description": "Automate cloud infrastructure provisioning, CI/CD pipelines, container orchestration, GitOps, system security, and real-time observability using Docker, Kubernetes, Terraform, AWS/GCP, Helm, and Prometheus/Grafana.",
  "aliases": [
    "devops engineer",
    "devops",
    "cloud devops engineer",
    "sre",
    "site reliability engineer",
    "cloud engineer"
  ],
  "estimatedMonths": 7,
  "estimatedHours": 220,
  "nodes": [
