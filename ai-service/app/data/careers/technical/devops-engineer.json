      "id": "linux-shell",
      "nodeId": "linux-shell",
      "title": "Linux System Administration & Shell Scripting",
      "description": "Master Linux CLI, file permissions, systemd process management, SSH keys, Bash scripting, and system performance monitoring.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": []
    },
    {
      "id": "networking-security",
      "nodeId": "networking-security",
      "title": "Networking & Security Fundamentals",
      "description": "Understand OSI Model, TCP/IP, DNS, HTTP/HTTPS protocols, SSL/TLS certificates, firewalls (iptables/ufw), and CIDR subnetting.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 0.95,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": []
    },
    {
