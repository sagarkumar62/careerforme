{
  "id": "doctor",
  "careerId": "doctor",
  "career_id": "doctor",
  "title": "Medical Doctor (Physician)",
  "domain": "healthcare",
  "description": "Diagnose, treat, and prevent human illnesses by mastering Human Anatomy, Physiology, Pathology, Pharmacology, Internal Medicine, General Surgery, Pediatrics, Emergency Medicine, and Clinical Clerkships.",
  "aliases": [
    "doctor",
    "physician",
    "medical doctor",
    "md",
    "general practitioner",
    "resident physician"
  ],
  "estimatedMonths": 24,
  "estimatedHours": 600,
  "nodes": [
    {
      "id": "human-anatomy-histology",
      "nodeId": "human-anatomy-histology",
      "title": "Human Gross Anatomy & Histology",
      "description": "Master human organ systems, musculoskeletal anatomy, neuroanatomy, cardiovascular structures, and microscopic tissue histology.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": []
    },
    {
      "id": "human-physiology",
      "nodeId": "human-physiology",
      "title": "Human Physiology & Homeostasis",
      "description": "Master cellular mechanisms, cardiovascular dynamics, renal function, respiratory gas exchange, endocrine control, and gastrointestinal systems.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "human-anatomy-histology"
      ]
    },
    {
      "id": "biochemistry-medical-genetics",
      "nodeId": "biochemistry-medical-genetics",
      "title": "Medical Biochemistry & Genetics",
      "description": "Master metabolic pathways (glycolysis, Krebs cycle), enzyme kinetics, molecular genetics, DNA replication, and hereditary gene mutations.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 0.95,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": []
    },
    {
      "id": "medical-microbiology-immunology",
      "nodeId": "medical-microbiology-immunology",
      "title": "Medical Microbiology & Immunology",
      "description": "Master bacteriology, virology, mycology, parasitology, innate/adaptive immunity, antibody response, and vaccination mechanisms.",
      "type": "foundation",
      "difficulty": "beginner",
      "importance": 0.95,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "human-physiology"
      ]
    },
    {
      "id": "pathology-disease-mechanisms",
      "nodeId": "pathology-disease-mechanisms",
      "title": "General & Systemic Pathology",
      "description": "Master cellular injury, inflammation, neoplasia/oncology, hemodynamic disorders, and organ-specific disease pathophysiology.",
      "type": "core",
      "difficulty": "intermediate",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "human-physiology",
        "biochemistry-medical-genetics"
      ]
    },
    {
      "id": "pharmacology-drug-therapeutics",
      "nodeId": "pharmacology-drug-therapeutics",
      "title": "Medical Pharmacology & Drug Therapeutics",
      "description": "Master pharmacokinetics, pharmacodynamics, autonomic drugs, antibiotics, cardiovascular medications, CNS drugs, and adverse drug reactions.",
      "type": "core",
      "difficulty": "intermediate",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "human-physiology",
        "pathology-disease-mechanisms"
      ]
    },
    {
      "id": "physical-diagnosis-clinical-skills",
      "nodeId": "physical-diagnosis-clinical-skills",
      "title": "Physical Examination & History Taking",
      "description": "Master patient history taking, physical examination techniques (auscultation, palpation, percussion), differential diagnosis, and medical charting.",
      "type": "core",
      "difficulty": "intermediate",
      "importance": 1.0,
      "recommended_level": 4,
      "requiredLevel": 4,
      "prerequisites": [
        "human-anatomy-histology",
        "human-physiology"
      ]
    },
    {
